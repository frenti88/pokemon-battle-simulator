{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/simulation/:path*",
      "destination": "/api/simulation"
    },
    {
      "source": "/api/multiplayer/:path*",
      "destination": "/api/multiplayer"
    }
  ],
  "headers": [
    {
      "source": "/api/multiplayer/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/simulation/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
